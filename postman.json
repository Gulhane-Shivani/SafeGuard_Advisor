{
	"info": {
		"_postman_id": "4c464cf6-9567-4a24-81d8-efcbf93aa1fd",
		"name": "SafeGuard Advisor API",
		"description": "Comprehensive API collection for SafeGuard Advisor insurance platform including Authentication, Admin Management, and Customer Portal.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "User Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"super_admin@safeguard.com\",\n    \"password\": \"password123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/login" }
					}
				},
				{
					"name": "Hardcoded Admin Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin_password_123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/admin/login" }
					}
				}
			]
		},
		{
			"name": "Admin Panel",
			"item": [
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": { "raw": "{{baseUrl}}/admin/users" }
					}
				},
				{
					"name": "Create User Account",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"full_name\": \"John Agent\",\n    \"email\": \"john.agent@safeguard.com\",\n    \"role\": \"AGENT\",\n    \"primary_branch\": \"Main Branch\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/admin/users" }
					}
				},
				{
					"name": "View Contact Messages",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": { "raw": "{{baseUrl}}/admin/contacts" }
					}
				}
			]
		},
		{
			"name": "Customer Portal",
			"item": [
				{
					"name": "Record Payment",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"policy\": \"Life Insurance Tech Plan\",\n    \"amount\": \"15000\",\n    \"method\": \"Credit Card\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/customer/payments" }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://127.0.0.1:8000" },
		{ "key": "token", "value": "YOUR_TOKEN_HERE" }
	]
}
