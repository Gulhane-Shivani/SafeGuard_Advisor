{
	"info": {
		"_postman_id": "4c464cf6-9567-4a24-81d8-efcbf93aa1fd",
		"name": "SafeGuard Advisor - Testing Collection",
		"description": "Complete collection for testing all SafeGuard Advisor backend endpoints, including new search and deletion features.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login (Admin/SuperAdmin)",
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"superadmin@safeguard.com\",\n    \"password\": \"password123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/login" }
					}
				},
				{
					"name": "Hardcoded Login",
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin_password_123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/admin/login" }
					}
				}
			]
		},
		{
			"name": "2. Super Admin - User Control",
			"item": [
				{
					"name": "List All Users (Search & Pagination)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
						"url": {
							"raw": "{{baseUrl}}/admin/users?search=john&page=1&page_size=10",
							"query": [
								{ "key": "search", "value": "john" },
								{ "key": "page", "value": "1" },
								{ "key": "page_size", "value": "10" }
							]
						}
					}
				},
				{
					"name": "Add New Staff (Admin/Agent/CSR)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"full_name\": \"New Testing User\",\n    \"email\": \"test.user@safeguard.com\",\n    \"role\": \"AGENT\",\n    \"primary_branch\": \"Main Branch\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{baseUrl}}/admin/users" }
					}
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
						"url": { "raw": "{{baseUrl}}/admin/users/1" }
					}
				}
			]
		},
		{
			"name": "3. Admin - Contacts",
			"item": [
				{
					"name": "Get Contact Messages",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
						"url": { "raw": "{{baseUrl}}/admin/contacts" }
					}
				},
				{
					"name": "Delete Contact",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
						"url": { "raw": "{{baseUrl}}/admin/contacts/1" }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://127.0.0.1:8000" },
		{ "key": "token", "value": "PASTE_TOKEN_HERE" }
	]
}
